# Supabase PostgreSQL connection string (use the pooler URL which supports IPv4)
# Get this from: Supabase Dashboard > Settings > Database > Connection string > URI
# Important: use the "Transaction pooler" (port 6543) connection string, not the direct one,
# because the direct hostname only resolves over IPv6 and will fail on most local machines.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Optional: add a Blob store for file uploads in production (set on Vercel).
# If unset, files are saved to the local public/uploads folder (suitable for local dev / single server).
BLOB_READ_WRITE_TOKEN=